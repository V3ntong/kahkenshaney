rules_version = '2';
// NOTE: Firebase App Check is not currently configured for this project.
// When moving to production, enable App Check with Play Integrity (Android)
// and DeviceCheck/App Attest (iOS) to prevent abuse.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if user is admin ──────────────────────────────────
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── items ────────────────────────────────────────────────────────────
    match /items/{itemId} {
      // Read: approved items visible to all; owner sees own items; admin sees all
      allow read: if request.auth != null
        && (resource.data.moderationStatus == 'approved'
            || resource.data.ownerUid == request.auth.uid
            || isAdmin());

      // Create: authenticated user can create their own items; the reporter
      // UID is recorded in reportedBy at creation time (auto-set pending)
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.reportedBy == request.auth.uid;

      // Update: admin can update all; owner can update non-moderation fields.
      // Status changes (including claiming) go through the claimItem Cloud
      // Function — the owner can no longer set status directly, which closes
      // the self-claim bypass.
      allow update: if request.auth != null
        && (isAdmin()
            || (resource.data.ownerUid == request.auth.uid
                && !request.resource.data.diff(resource.data)
                     .affectedKeys().hasAny(['moderationStatus', 'status', 'claimedBy'])));

      // Delete: owner or admin
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      // A4 — non-exclusive claims: every claim on the item lives here.
      // Written ONLY by Cloud Functions (claimItem / approveClaim — the
      // Admin SDK bypasses rules); any signed-in user may read the list so
      // the UI can show "N people have claimed this item".
      match /claims/{claimId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── resolvedFeed (public homepage "Recently Resolved" feed, A1) ──────
    // Entries contain display names and item photos only (no email/phone/
    // user IDs) and are written exclusively by Cloud Functions when a claim
    // is approved. All signed-in users may read the feed; no client writes.
    match /resolvedFeed/{entryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null;

      // Users may only create their own profile and must NOT set privileged
      // fields (isAdmin/role) — admin assignment happens server-side only
      // (grantAdminIfAuthorized Cloud Function / custom claims).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !('isAdmin' in request.resource.data)
        && !('role' in request.resource.data);

      // Self-updates are allowed for profile fields, but never for
      // privileged fields — a normal user cannot self-promote.
      allow update: if request.auth != null
        && (isAdmin()
            || (request.auth.uid == uid
                && !request.resource.data.diff(resource.data)
                     .affectedKeys().hasAny(['isAdmin', 'role'])));

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── users/{uid}/blocked_users ─────────────────────────────────────
    match /users/{uid}/blocked_users/{blockedUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── users/{uid}/preferences ───────────────────────────────────────
    match /users/{uid}/preferences/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── moderation_reports ─────────────────────────────────────────────
    match /moderation_reports/{reportId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // ── users/{uid}/notifications ────────────────────────────────────────
    match /users/{userId}/notifications/{notificationId} {
      // Only the user can read their own notifications; admin can read all
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Any authenticated user can create notifications (for claim flows,
      // admin moderation, etc.). The server should validate intent.
      allow create: if request.auth != null;

      // Only the user can mark their own notifications as read
      allow update: if request.auth != null
        && request.auth.uid == userId;

      // No deletion allowed
      allow delete: if false;
    }

    // ── users/{uid}/posts ──────────────────────────────────────────────
    match /users/{uid}/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── admin invites (created ONLY by Cloud Functions) ──────────────────
    match /adminInvites/{inviteId} {
      // Read: administrators only. Invitees learn about their own invitation
      // via the `getMyAdminInvite` callable, because a token email's casing
      // cannot be compared case-insensitively in rules.
      allow read: if request.auth != null && isAdmin();

      // All writes go through Cloud Functions (Admin SDK bypasses rules).
      allow write: if false;
    }

    // ── chatbot history (per-user, server-side Gemini) ────────────────
    match /chatbot_history/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── chats (1-on-1 support messages) ─────────────────────────────────
    match /chats/{chatId} {

      // True when the caller's UID is one of the two halves encoded in a
      // peer-chat document ID (`peer_{uidA}_{uidB}`, sorted client-side).
      // Firebase Auth UIDs only contain characters that are literal in RE2,
      // so the UID can be interpolated into this pattern safely.
      function inPeerId() {
        return chatId.matches('peer_' + request.auth.uid + '_.+')
            || chatId.matches('peer_.+_' + request.auth.uid);
      }

      // Read: the thread owner (support chats), an admin, one of the two
      // users encoded in a peer-chat ID (so `ensurePeerChat` can probe a
      // thread that does not exist yet), or a recorded participant of an
      // existing thread. The `resource == null` branch must come before any
      // `resource.data` access — reading a missing document would otherwise
      // abort with a null-value error and deny the existence probe.
      allow read: if request.auth != null
        && (request.auth.uid == chatId
            || isAdmin()
            || (resource == null && inPeerId())
            || (resource != null
                && 'participants' in resource.data
                && request.auth.uid in resource.data.participants));

      // Create: support threads only under the caller's own UID (with the
      // caller among the participants), and peer threads only when the
      // participants array is exactly the two UIDs encoded in the document
      // ID and the caller is one of them. This stops a user from opening a
      // thread under someone else's UID or hijacking a peer-chat ID with a
      // mismatched participants array.
      allow create: if request.auth != null
        && ((request.auth.uid == chatId
                && request.auth.uid in request.resource.data.participants)
            || (request.resource.data.participants is list
                && request.resource.data.participants.size() == 2
                && request.auth.uid in request.resource.data.participants
                && (chatId == 'peer_' + request.resource.data.participants[0]
                        + '_' + request.resource.data.participants[1]
                    || chatId == 'peer_' + request.resource.data.participants[1]
                        + '_' + request.resource.data.participants[0])));

      allow update: if request.auth != null
        && (request.auth.uid == chatId
            || (resource != null
                && 'participants' in resource.data
                && request.auth.uid in resource.data.participants)
            || isAdmin());

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid == chatId
              || isAdmin()
              || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);

        allow create: if request.auth != null
          && (request.auth.uid == chatId
              || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
              || isAdmin())
          && request.resource.data.senderId == request.auth.uid;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
