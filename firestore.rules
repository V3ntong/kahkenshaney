rules_version = '2';
// NOTE: Firebase App Check is not currently configured for this project.
// When moving to production, enable App Check with Play Integrity (Android)
// and DeviceCheck/App Attest (iOS) to prevent abuse.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if user is admin ──────────────────────────────────
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── items ────────────────────────────────────────────────────────────
    match /items/{itemId} {
      // Read: approved items visible to all; owner sees own items; admin sees all
      allow read: if request.auth != null
        && (resource.data.moderationStatus == 'approved'
            || resource.data.ownerUid == request.auth.uid
            || isAdmin());

      // Create: authenticated user can create their own items; the reporter
      // UID is recorded in reportedBy at creation time (auto-set pending)
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.reportedBy == request.auth.uid;

      // Update: admin can update all; owner can update non-moderation fields.
      // Status changes (including claiming) go through the claimItem Cloud
      // Function — the owner can no longer set status directly, which closes
      // the self-claim bypass.
      allow update: if request.auth != null
        && (isAdmin()
            || (resource.data.ownerUid == request.auth.uid
                && !request.resource.data.diff(resource.data)
                     .affectedKeys().hasAny(['moderationStatus', 'status', 'claimedBy'])));

      // Delete: owner or admin
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ── users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null;

      // Users may only create their own profile and must NOT set privileged
      // fields (isAdmin/role) — admin assignment happens server-side only
      // (grantAdminIfAuthorized Cloud Function / custom claims).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !('isAdmin' in request.resource.data)
        && !('role' in request.resource.data);

      // Self-updates are allowed for profile fields, but never for
      // privileged fields — a normal user cannot self-promote.
      allow update: if request.auth != null
        && (isAdmin()
            || (request.auth.uid == uid
                && !request.resource.data.diff(resource.data)
                     .affectedKeys().hasAny(['isAdmin', 'role'])));

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── users/{uid}/blocked_users ─────────────────────────────────────
    match /users/{uid}/blocked_users/{blockedUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── users/{uid}/preferences ───────────────────────────────────────
    match /users/{uid}/preferences/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── moderation_reports ─────────────────────────────────────────────
    match /moderation_reports/{reportId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // ── users/{uid}/notifications ────────────────────────────────────────
    match /users/{userId}/notifications/{notificationId} {
      // Only the user can read their own notifications; admin can read all
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Any authenticated user can create notifications (for claim flows,
      // admin moderation, etc.). The server should validate intent.
      allow create: if request.auth != null;

      // Only the user can mark their own notifications as read
      allow update: if request.auth != null
        && request.auth.uid == userId;

      // No deletion allowed
      allow delete: if false;
    }

    // ── users/{uid}/posts ──────────────────────────────────────────────
    match /users/{uid}/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── chatbot history (per-user, server-side Gemini) ────────────────
    match /chatbot_history/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── chats (1-on-1 support messages) ─────────────────────────────────
    match /chats/{chatId} {
      allow read: if request.auth != null
        && (request.auth.uid == chatId
            || request.auth.uid in resource.data.participants
            || isAdmin());

      allow create: if request.auth != null
        && (request.auth.uid == chatId
            || request.auth.uid in request.resource.data.participants);

      allow update: if request.auth != null
        && (request.auth.uid == chatId
            || request.auth.uid in resource.data.participants
            || isAdmin());

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid == chatId
              || isAdmin()
              || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);

        allow create: if request.auth != null
          && (request.auth.uid == chatId
              || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
              || isAdmin())
          && request.resource.data.senderId == request.auth.uid;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
