<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Remove ProfileInstaller provider in debug to prevent disk I/O that
         causes "Lost connection to device" on budget Infinix devices. -->
    <application>
        <provider
            android:name="androidx.profileinstaller.ProfileInstallerProvider"
            android:authorities="${applicationId}.profileinstaller"
            tools:node="remove" />
    </application>
</manifest>
