rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── lost_and_found images ────────────────────────────────────────────
    match /lost_and_found/{type}/{fileName} {
      // Anyone authenticated can read images.
      allow read: if request.auth != null;

      // Only authenticated users can upload; path must match type.
      allow create: if request.auth != null
        && (type == 'lost' || type == 'found')
        && request.resource.contentType.matches('image/.*');

      // Only the uploader (matched via custom metadata) can delete.
      allow delete: if request.auth != null
        && request.auth.uid == resource.metadataUploaderId;
    }

    // ── profile images (posts + avatars) ─────────────────────────────────
    match /profiles/{uid}/{allPaths=**} {
      allow read: if request.auth != null;

      // Users may only upload into their own profile folder.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*');

      // Owners can delete their own uploads (path-scoped or via metadata).
      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.uid == resource.metadataUploaderId);
    }

    // ── chat images ──────────────────────────────────────────────────────
    match /chat_images/{fileName} {
      allow read: if request.auth != null;

      // Any authenticated user may share an image in chat.
      allow create: if request.auth != null
        && request.resource.contentType.matches('image/.*');

      // Only the uploader (via custom metadata) can delete.
      allow delete: if request.auth != null
        && request.auth.uid == resource.metadataUploaderId;
    }

    // ── everything else (legacy paths) ───────────────────────────────────
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Block new writes to unknown paths.
    }
  }
}