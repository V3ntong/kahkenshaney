# Email delivery (SMTP). Never commit real values to source control.
#
# Emulator note: if this file is absent (or SMTP_HOST is empty), the Functions
# emulator automatically switches to a development logger transport - the OTP
# email is printed to the emulator console instead of being sent. This keeps
# the whole flow testable without an email provider.
#
# Production: real values MUST be set. Use:
#   firebase functions:secrets:set SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASS MAIL_FROM APP_NAME
#
# Works with any SMTP provider:
#   - Gmail App Password (SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true)
#   - Mailtrap (development)
#   - Brevo / SendGrid SMTP relay
#   - Any other SMTP service

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username-or-apikey
SMTP_PASS=your-smtp-password-or-apikey
MAIL_FROM=no-reply@yourdomain.com
APP_NAME=KAH KEN SHA NEY
